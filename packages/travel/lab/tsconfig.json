{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    // Node, because the runner is a script. DOM, because the body of a
    // `page.evaluate` is genuinely DOM code — it is serialised across to the
    // browser and runs there. The alternative is hand-declaring `document` in
    // every extractor, which trades a real type for a plausible-looking one.
    "types": ["node"],
    "lib": ["ES2023", "DOM"]
  },
  "include": ["src"]
}
